POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=a_remplacer

# Environnement : dev ou prod, obligatoire, aucune valeur par défaut
BOOKS_ENV=dev

# Dossier des pages brutes SUR L'HÔTE, monté dans le collecteur sur /data/raw.
# Le dossier doit exister avant le lancement : Docker ne le crée pas.
#   dev (PC)    : ./data/raw (relatif au dépôt, ignoré par Git)
#   prod (atlas): /home/arnaud/books-data/raw
#                 chemin absolu obligatoire : le ~ n'est pas interprété dans un .env
BOOKS_RAW_DIR=./data/raw

# Mot de passe du rôle books_collector (migration 002), défini dans psql avec \password
# (voir README) puis recopié ici. Différent en dev et en prod.
BOOKS_COLLECTOR_PASSWORD=a_remplacer

# POSTGRES_HOST et POSTGRES_PORT ne se règlent pas ici :
# ils sont fixés dans docker-compose.yml (postgres / 5432).
