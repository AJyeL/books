POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=a_remplacer

# Environnement : dev ou prod, obligatoire, aucune valeur par défaut
BOOKS_ENV=dev

# Dossier des pages brutes SUR L'HÔTE, monté dans le collecteur sur /data/raw.
# Le dossier doit exister avant le lancement : Docker ne le crée pas.
#   dev (PC)    : ./data/raw (relatif au dépôt, ignoré par Git)
#   prod (atlas): /home/arnaud/books-data/raw
#                 chemin absolu obligatoire : le ~ n'est pas interprété dans un .env
BOOKS_RAW_DIR=./data/raw

# Dossier des captures SUR L'HÔTE (inbox/, quarantaine/, attente/, verrou), monté sur /data/captures.
# Le dossier et ses sous-dossiers doivent exister avant le lancement : Docker ne les crée pas (voir README).
#   dev (PC)    : ./data/ingestion (dossier de dev, distinct de data/captures/ qui garde les vraies captures)
#   prod (atlas): /home/arnaud/books-data/captures
BOOKS_CAPTURES_DIR=./data/ingestion

# Mot de passe du rôle books_collector (migration 002), défini dans psql avec \password
# (voir README) puis recopié ici. Différent en dev et en prod.
BOOKS_COLLECTOR_PASSWORD=a_remplacer

# Mot de passe du rôle books_transformer (migration 005, extracteur de la décision 011), défini de la même façon.
# Différent de celui de books_collector, et différent en dev et en prod.
BOOKS_TRANSFORMER_PASSWORD=a_remplacer

# DEV UNIQUEMENT (PC) : ajoute docker-compose.dev.yml, qui donne au collecteur les pages
# enregistrées à la main (data/samples). À décommenter sur le PC, JAMAIS sur atlas.
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
#COMPOSE_PATH_SEPARATOR=:

# POSTGRES_HOST et POSTGRES_PORT ne se règlent pas ici :
# ils sont fixés dans docker-compose.yml (postgres / 5432).
