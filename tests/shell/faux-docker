#!/bin/sh
# Doublure de test de « docker », sur un faux atlas ou dans un conteneur de test.
#
# « docker compose exec … » (pg_dump de scripts/backup.sh et scripts/exporter-sauvegarde.sh) :
#   écrit sur la sortie standard le contenu de ~/faux-dump (à défaut, un petit faux dump binaire)
#   et rend le code écrit dans ~/code-pg-dump (0 par défaut ; message sur la sortie d'erreur sinon).
#
# « docker compose --profile transformer run … » (extraction de scripts/recevoir-captures.sh, décision 012) :
#   note « extraction » dans ~/appels, affiche un faux bilan et rend le code écrit dans ~/code-extraction (0 par défaut).
#
# Autres appels (« docker compose --profile collector run … », ingestion de scripts/recevoir-captures.sh) :
#   note « ingestion » dans ~/appels, déplace les lots de inbox/ dans ~/recues/ (pour vérifier les octets reçus),
#   affiche un faux bilan et rend le code de sortie écrit dans ~/code-ingestion (0 par défaut).
if [ "${1:-}" = compose ] && [ "${2:-}" = --profile ] && [ "${3:-}" = transformer ]; then
    echo extraction >> "$HOME/appels"
    code=$(cat "$HOME/code-extraction" 2>/dev/null || echo 0)
    echo "Bilan factice de l'extraction — code de sortie $code"
    exit "$code"
fi
if [ "${1:-}" = compose ] && [ "${2:-}" = exec ]; then
    code=$(cat "$HOME/code-pg-dump" 2>/dev/null || echo 0)
    if [ "$code" -ne 0 ]; then
        echo "pg_dump factice : erreur simulée" >&2
        exit "$code"
    fi
    if [ -f "$HOME/faux-dump" ]; then
        cat "$HOME/faux-dump"
    else
        # Signature du format custom, puis des octets délicats : nul, retour chariot, saut de ligne, 0x1A, 0xFF
        printf 'PGDMP\001\016\000\r\n\032\377fin'
    fi
    exit 0
fi

echo ingestion >> "$HOME/appels"
captures="$HOME/books-data/captures"
mkdir -p "$HOME/recues"
n=$(find "$captures/inbox" -type f | wc -l)
for lot in "$captures"/inbox/*/; do
    [ -d "$lot" ] && mv "$lot" "$HOME/recues/"
done
code=$(cat "$HOME/code-ingestion" 2>/dev/null || echo 0)
echo "Bilan factice : $n fichier(s) ingéré(s)"
echo "Résultat factice — code de sortie $code"
exit "$code"
