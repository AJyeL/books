# --- Secrets : ne JAMAIS publier ---
.env

# --- Données collectées : jamais dans Git ---
data/
*.html
# Exception : fausses pages de test, aux valeurs inventées (voir tests/fixtures/README.md)
!tests/fixtures/*.html
!tests/fixtures/captures/*.html
*.html.gz
*.csv
# Exception : rapports Amazon Ads de test, aux valeurs inventées (voir tests/fixtures/README.md)
!tests/fixtures/ads/*.csv
*.dump
*.sql.gz

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/

# --- Éditeurs et systèmes ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Extension de capture : code conservé dans un dépôt privé séparé (décision 006) ---
extension/

# --- Réglages locaux des scripts du PC : envoi des captures, copie de la base (chemins personnels) ---
scripts/*.local.psd1

# --- Notes privées : jamais publiées ---
CLAUDE.md
CLAUDE.local.md
private/

# --- Power BI (décision 022) : un .pbix importé contient des données réelles ; jamais dans le dépôt ---
*.pbix
