# Réglage local du script d'envoi des captures (décision 008).
# Copier ce fichier en envoyer-captures.local.psd1, à côté de lui, puis indiquer votre dossier.
# Le fichier .local.psd1 est ignoré par Git : votre chemin personnel n'entre jamais dans le dépôt public.
@{
    # Dossier où l'extension dépose les captures sur ce PC ; envoyees\ y sera créé
    DossierCaptures = 'C:\Chemin\vers\books-captures'
}
